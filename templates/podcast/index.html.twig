{% extends 'public.html.twig' %}

{% block title %}بودكاست - أوال فيمينا
{% endblock %}

{% block page_content %}
	<div id="podcasts" dir="rtl" class="py-8">
		<h2 class="text-5xl font-bold text-center mb-4">
			<span class="pink-underline">بودكاست</span>
		</h2>
		<p class="text-center text-gray-600 text-xl mb-16">
			استمعوا إلى أصواتهن — حلقات صوتية مبدعة من أوال فيمينا
		</p>

		{% if podcasts is empty %}
			{# Skeleton holding state #}
			<p class="text-center text-gray-400 text-lg mt-4 mb-6">ترقبوا الحلقة الأولى — أكتوبر 2026..</p>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
				{% for i in 1..3 %}
					<div class="bg-white rounded-2xl p-8 shadow-custom border border-[#FFE4E6] animate-pulse">
						<div class="w-24 h-24 rounded-full mx-auto mb-6 bg-rose-100"></div>
						<div class="h-5 bg-rose-100 rounded-full w-3/4 mx-auto mb-3"></div>
						<div class="h-4 bg-gray-100 rounded-full w-1/2 mx-auto mb-6"></div>
						<div class="h-8 bg-rose-50 rounded-full w-1/3 mx-auto mb-6"></div>
						<hr class="border-rose-100"/>
					</div>
				{% endfor %}
			</div>
		{% else %}
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
				{% for podcast in podcasts %}
					<a href="{{ path('app_podcast_show', {'id': podcast.id}) }}">
						<div class="bg-white rounded-2xl p-8 shadow-custom hover:shadow-custom-lg transition text-center border border-[#FFE4E6] group">
							<div class="bg-gradient-to-br from-rose-400 to-rose-600 w-24 h-24 rounded-full mx-auto mb-6 flex items-center justify-center overflow-hidden">
								{% if podcast.image %}
									<img src="{{ asset('uploads/' ~ podcast.image.name) }}" alt="{{ podcast.title }}" class="w-full h-full object-cover"/>
								{% else %}
									<svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-white" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewbox="0 0 24 24">
										<path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
										<path d="M19 10v1a7 7 0 0 1-14 0v-1"/>
										<line x1="12" y1="19" x2="12" y2="23"/>
										<line x1="8" y1="23" x2="16" y2="23"/>
									</svg>
								{% endif %}
							</div>

							<h3 class="text-2xl font-bold mb-2 group-hover:text-rose-600 transition-colors">{{ podcast.title }}</h3>

							{% if podcast.subTitle %}
								<p class="text-gray-600 mb-4 line-clamp-2">{{ podcast.subTitle }}</p>
							{% endif %}

							{% if podcast.createdAt is defined and podcast.createdAt %}
								<div class="bg-rose-50 text-rose-500 px-4 py-2 rounded-full inline-flex items-center gap-2 mb-6 text-sm">
									<svg class="w-4 h-4" fill="none" stroke="currentColor" viewbox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
									</svg>
									<span>{{ podcast.createdAt|date('d/m/Y') }}</span>
								</div>
							{% endif %}

							<hr class="border-rose-200"/>
							<div class="mt-4 flex justify-center">
								<span class="text-rose-600 font-semibold text-sm flex items-center gap-1">
									<svg class="w-4 h-4" fill="currentColor" viewbox="0 0 24 24">
										<path d="M8 5v14l11-7z"/>
									</svg>
									استمع الآن
								</span>
							</div>
						</div>
					</a>
				{% endfor %}
			</div>
		{% endif %}
	</div>
{% endblock %}

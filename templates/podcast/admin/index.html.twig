{% extends 'admin.html.twig' %}

{% block title %}بودكاست
{% endblock %}

{% block content %}
	<div class="flex-1 flex flex-col bg-gray-50 px-4">
		<header class="bg-white py-6 border-b border-gray-200">
			<div class="flex flex-wrap justify-between items-center gap-4">
				<div>
					<h1 class="text-2xl font-semibold text-gray-900">بودكاست</h1>
				</div>
				<a href="{{ path('app_admin_podcast_new') }}" class="bg-[#A81B60] text-white px-4 py-2 rounded-lg flex items-center hover:bg-teal-700 transition duration-200">
					<svg class="w-5 h-5 mr-2" fill="currentColor" viewbox="0 0 20 20">
						<path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd"></path>
					</svg>
					بودكاست جديد
				</a>
			</div>
			<hr class="text-gray-300 mt-4 mb-2">
		</header>

		<div class="pb-8">
			<div class="bg-white rounded-lg table-box-shadow overflow-hidden">
				{% if podcasts|length > 0 %}
					<div class="overflow-x-auto">
						<table class="w-full min-w-[800px]">
							<thead class="bg-light-gray-300 border-b border-t border-light-gray-200">
								<tr>
									<th class="px-6 py-3 text-right text-xs font-medium text-gray-600 tracking-wider whitespace-nowrap">العنوان</th>
									<th class="px-6 py-3 text-right text-xs font-medium text-gray-600 tracking-wider whitespace-nowrap">العنوان الفرعي</th>
									<th class="px-6 py-3 text-right text-xs font-medium text-gray-600 tracking-wider whitespace-nowrap">الصورة</th>
									<th class="px-6 py-3 text-right text-xs font-medium text-gray-600 tracking-wider whitespace-nowrap">الحالة</th>
									<th class="px-6 py-3 text-right text-xs font-medium text-gray-600 tracking-wider whitespace-nowrap">تاريخ الإنشاء</th>
									<th class="px-6 py-3 text-left text-xs font-medium text-gray-600 tracking-wider whitespace-nowrap">الإجراءات</th>
								</tr>
							</thead>
							<tbody class="bg-white divide-y divide-gray-200">
								{% for podcast in podcasts %}
									<tr class="hover:bg-gray-50 transition duration-150 border-b border-light-gray-200">
										<td class="px-6 py-4 whitespace-nowrap">
											<div class="text-sm text-gray-900 max-w-[200px] truncate">{{ podcast.title }}</div>
										</td>
										<td class="px-6 py-4 whitespace-nowrap">
											<div class="text-sm text-gray-900 max-w-[200px] truncate">{{ podcast.subTitle }}</div>
										</td>
										<td class="px-6 py-4 whitespace-nowrap">
											{% if podcast.image %}
												<img src="{{ '/uploads/' ~ podcast.image.name }}" alt="{{ podcast.title }}" class="w-12 h-12 rounded-lg object-cover">
											{% else %}
												<div class="w-12 h-12 rounded-lg bg-gray-100 flex items-center justify-center">
													<svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewbox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 10v1a7 7 0 0 1-14 0v-1"/></svg>
												</div>
											{% endif %}
										</td>
										<td class="px-6 py-4 whitespace-nowrap">
											{% if podcast.statut == 'published' %}
												<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Publié</span>
											{% elseif podcast.statut == 'draft' %}
												<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">Brouillon</span>
											{% elseif podcast.statut == 'waiting_approval' %}
												<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">En attente</span>
											{% else %}
												<span class="inline-flex px-2.5 py-0.5 rounded-full text-xs bg-gray-100 text-gray-800">{{ podcast.statut }}</span>
											{% endif %}
										</td>
										<td class="px-6 py-4 whitespace-nowrap">
											<div class="text-sm text-gray-900">{{ podcast.createdAt is defined and podcast.createdAt ? podcast.createdAt|date('d/m/Y à H:i') : 'Non définie' }}</div>
										</td>
										<td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
											<div class="flex items-center space-x-4">
												<a href="{{ path('app_admin_podcast_show', {'id': podcast.id}) }}" class="text-gray-400 hover:text-gray-600 transition duration-150" title="Voir">
													<img src="{{ asset('build/images/icons/eye.svg') }}" alt="Voir" class="w-5 h-5 min-w-4 min-h-4">
												</a>
												<a href="{{ path('app_admin_podcast_edit', {'id': podcast.id}) }}" class="text-gray-400 hover:text-gray-600 transition duration-150" title="Modifier">
													<img src="{{ asset('build/images/icons/edit.svg') }}" alt="Modifier" class="w-5 h-5 min-w-4 min-h-4">
												</a>
												<button class="delete-btn text-gray-400 hover:text-red-600 transition duration-150 cursor-pointer" title="Supprimer" data-podcast-id="{{ podcast.id }}" data-csrf-token="{{ csrf_token('delete' ~ podcast.id) }}">
													<img src="{{ asset('build/images/icons/trash.svg') }}" alt="Supprimer" class="w-5 h-5 min-w-4 min-h-4">
												</button>
											</div>
										</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				{% else %}
					<div class="text-center py-12">
						<svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewbox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3zM19 10v1a7 7 0 0 1-14 0v-1M12 19v4M8 23h8"></path>
						</svg>
						<h3 class="mt-2 text-sm font-medium text-gray-900">لم يتم العثور على أي بودكاست</h3>
						<p class="mt-1 text-sm text-gray-600">إنشاء بودكاست جديد</p>
					</div>
				{% endif %}
			</div>
		</div>
	</div>

	<!-- Delete Modal -->
	<div id="deleteModal" class="fixed inset-0 bg-modal overflow-y-auto h-full w-full hidden z-50 modal-backdrop">
		<div id="modalContent" class="relative top-1/4 mx-auto p-4 md:p-5 modal-box-shadow w-11/12 max-w-sm md:w-96 rounded-md bg-white modal-content">
			<div class="flex justify-between items-start">
				<img src="{{ asset('build/images/icons/delete.svg') }}" alt="Supprimer" class="w-10 h-10 md:w-12 md:h-12">
				<button id="closeModalBtn" class="text-gray-400 hover:text-gray-600 hover:cursor-pointer">
					<svg class="w-5 h-5 md:w-6 md:h-6" fill="currentColor" viewbox="0 0 20 20">
						<path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
					</svg>
				</button>
			</div>
			<div class="mt-3">
				<h3 class="text-base md:text-lg font-medium text-gray-900">Supprimer le podcast</h3>
				<p class="text-xs md:text-sm text-gray-600 mb-4 md:mb-6">Êtes-vous sûr de vouloir supprimer ce podcast ? Cette action ne peut pas être annulée.</p>
				<div class="flex flex-col md:flex-row space-y-2 md:space-y-0 md:space-x-4">
					<button id="cancelDeleteBtn" class="px-4 py-2 flex-1 border border-light-gray-100 text-gray-800 text-sm md:text-base font-medium rounded-md hover:bg-gray-50 transition duration-150 cursor-pointer">Annuler</button>
					<button id="confirmDeleteBtn" class="px-4 py-2 flex-1 bg-red-600 text-white text-sm md:text-base font-medium rounded-md hover:bg-red-700 transition duration-150 cursor-pointer">Supprimer</button>
				</div>
			</div>
		</div>
	</div>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script>
		function initializeDeleteModal() {
let podcastToDelete = null;
let csrfTokenForDelete = null;
let isModalAnimating = false;

document.querySelectorAll('.delete-btn').forEach(btn => {
btn.replaceWith(btn.cloneNode(true));
});

function showDeleteModal(id) {
if (isModalAnimating) 
return;



podcastToDelete = id;
const deleteButton = document.querySelector (`[data-podcast-id="${id}"]`);
csrfTokenForDelete = deleteButton ? deleteButton.dataset.csrfToken : null;
const modal = document.getElementById('deleteModal');
const modalContent = document.getElementById('modalContent');
if (! modal || ! modalContent) 
return;



modal.classList.remove('hidden');
modal.classList.add('modal-entering');
modalContent.classList.add('modal-entering');
isModalAnimating = true;

requestAnimationFrame(() => {
modal.classList.remove('modal-entering');
modal.classList.add('modal-entered');
modalContent.classList.remove('modal-entering');
modalContent.classList.add('modal-entered');
setTimeout(() => {
isModalAnimating = false;
}, 300);
});
}

function hideDeleteModal() {
if (isModalAnimating) 
return;



const modal = document.getElementById('deleteModal');
const modalContent = document.getElementById('modalContent');
if (! modal || ! modalContent) 
return;



isModalAnimating = true;

modal.classList.remove('modal-entered');
modal.classList.add('modal-exiting');
modalContent.classList.remove('modal-entered');
modalContent.classList.add('modal-exiting');

requestAnimationFrame(() => {
modal.classList.remove('modal-exiting');
modal.classList.add('modal-exited');
modalContent.classList.remove('modal-exiting');
modalContent.classList.add('modal-exited');
setTimeout(() => {
modal.classList.add('hidden');
modal.classList.remove('modal-exited');
modalContent.classList.remove('modal-exited');
podcastToDelete = null;
csrfTokenForDelete = null;
isModalAnimating = false;
}, 300);
});
}

function deleteItem() {
if (podcastToDelete && csrfTokenForDelete) {
const form = document.createElement('form');
form.method = 'POST';
form.action = `{{ path('app_admin_podcast_delete', {'id': '__ID__'}) }}`.replace('__ID__', podcastToDelete);

const csrfToken = document.createElement('input');
csrfToken.type = 'hidden';
csrfToken.name = '_token';
csrfToken.value = csrfTokenForDelete;
form.appendChild(csrfToken);

document.body.appendChild(form);
form.submit();
}
hideDeleteModal();
}

document.querySelectorAll('.delete-btn').forEach(button => {
button.addEventListener('click', function () {
showDeleteModal(this.dataset.podcastId);
});
});

const closeBtn = document.getElementById('closeModalBtn');
const cancelBtn = document.getElementById('cancelDeleteBtn');
const confirmBtn = document.getElementById('confirmDeleteBtn');
const modal = document.getElementById('deleteModal');

if (closeBtn) 
closeBtn.addEventListener('click', hideDeleteModal);



if (cancelBtn) 
cancelBtn.addEventListener('click', hideDeleteModal);



if (confirmBtn) 
confirmBtn.addEventListener('click', deleteItem);



if (modal) {
modal.addEventListener('click', function (e) {
if (e.target === this && ! isModalAnimating) 
hideDeleteModal();



});
}
}
document.addEventListener('DOMContentLoaded', initializeDeleteModal);
document.addEventListener('turbo:load', initializeDeleteModal);
	</script>
{% endblock %}

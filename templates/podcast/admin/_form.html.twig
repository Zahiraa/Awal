{{ form_start(form, {'attr': {'class': 'mx-auto p-6 bg-white rounded-lg shadow-sm'}}) }}

{% block head_scripts %}
	

	{# jQuery #}
	<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

	{# Summernote #}
	<link
		href="https://cdn.jsdelivr.net/npm/summernote@0.9.0/dist/summernote-lite.min.css"
		rel="stylesheet"
	>
	<script src="https://cdn.jsdelivr.net/npm/summernote@0.9.0/dist/summernote-lite.min.js"></script>

	{# Police Amiri pour l'arabe #}
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link
		href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&display=swap"
		rel="stylesheet"
	>

	<style>
		.note-editor {
			width: 100%;
		}

		.note-editable {
			font-family: "Amiri", serif !important;
			font-size: 22px !important;
			line-height: 1.8 !important;
		}

		.note-editable p,
		.note-editable div,
		.note-editable span {
			font-family: "Amiri", serif;
		}

		.note-editable[dir="rtl"] {
			direction: rtl;
			text-align: right;
		}
	</style>

	<script>
		function initSummernote() {
			if (typeof $ === "undefined") {
				setTimeout(initSummernote, 100);
				return;
			}

			/*
			 * IMPORTANT :
			 * Le champ Symfony est podcast_content.
			 * L'ancien code cherchait opinion_content.
			 */
			const element = $("#podcast_content");

			if (element.length === 0) {
				setTimeout(initSummernote, 100);
				return;
			}

			/*
			 * Avec Turbo, la fonction peut être appelée plusieurs fois.
			 * On évite donc de créer plusieurs éditeurs.
			 */
			if (element.next(".note-editor").length > 0) {
				return;
			}

			element.summernote({
				height: 300,
				tabsize: 2,

				/*
				 * Liste des polices disponibles
				 */
				fontNames: [
					"Amiri",
					"Arial",
					"Helvetica",
					"Times New Roman",
					"Courier New",
				],

				/*
				 * Summernote peut ne pas trouver Amiri localement.
				 * On ignore donc cette vérification.
				 */
				fontNamesIgnoreCheck: ["Amiri"],

				toolbar: [
					["font", ["bold", "underline", "clear", "italic", "strikethrough"]],

					["fontname", ["fontname"]],

					["style", ["style"]],

					["color", ["color"]],

					["para", ["ul", "ol", "paragraph"]],

					["table", ["table"]],

					["insert", ["link", "picture", "video"]],

					["view", ["codeview", "help"]],
				],

				callbacks: {
					/*
					 * Initialisation de l'éditeur
					 */
					onInit: function () {
						const editor = $(this).next(".note-editor");
						const editable = editor.find(".note-editable");

						editable.css({
							"font-family": "'Amiri', serif",
							"font-size": "22px",
							"line-height": "1.8",
							direction: "rtl",
							"text-align": "right",
						});
					},

					/*
					 * Synchronisation avec le textarea Symfony
					 */
					onChange: function () {
						$(this).val($(this).summernote("code"));
					},
				},
			});
		}

		/*
		 * Chargement normal de la page
		 */
		document.addEventListener("DOMContentLoaded", function () {
			initSummernote();
		});

		/*
		 * Navigation avec Turbo
		 */
		document.addEventListener("turbo:load", function () {
			initSummernote();
		});
	</script>
{% endblock %}


{% set maxTaille = "50Mo" %}
{% set maxTailleImage = "5Mo" %}


<!-- ========================================================= -->
<!-- SECTION UPLOAD IMAGE -->
<!-- ========================================================= -->

<div class="flex flex-col md:flex-row gap-4 mb-6 mt-4 items-stretch">

	<!-- Zone Upload Image -->
	<label
		for="{{ form.image.vars.id }}"
		class="flex-1 flex flex-col items-center justify-center cursor-pointer p-4 rounded-lg"
		style="border: 1px solid #E3EDF2"
	>

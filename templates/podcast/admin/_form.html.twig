</div>


<!-- ========================================================= -->
<!-- JAVASCRIPT UPLOAD IMAGE / MEDIA -->
<!-- ========================================================= -->

<script>
	(function () {
		const imageInput = document.getElementById("{{ form.image.vars.id }}");
		const mediaInput = document.getElementById("{{ form.media.vars.id }}");

		const fileModal = document.getElementById("fileModal");
		const modalTitle = document.getElementById("modal-title");
		const closeBtn = document.getElementById("close-modal-btn");

		/*
		 * Fermeture du modal
		 */
		if (closeBtn && fileModal) {
			closeBtn.addEventListener("click", function () {
				fileModal.style.display = "none";
				fileModal.classList.add("hidden");
			});
		}

		/*
		 * Fermeture du modal en cliquant à l'extérieur
		 */
		if (fileModal) {
			fileModal.addEventListener("click", function (event) {
				if (event.target === fileModal) {
					fileModal.style.display = "none";
					fileModal.classList.add("hidden");
				}
			});
		}

		/*
		 * =========================================================
		 * IMAGE
		 * =========================================================
		 */

		if (imageInput) {
			imageInput.addEventListener("change", function (event) {
				const file = event.target.files[0];

				if (!file) {
					return;
				}

				if (!file.type.startsWith("image/")) {
					return;
				}

				const fileSizeMB = file.size / (1024 * 1024);

				/*
				 * Limite : 5 MB
				 */
				if (fileSizeMB >= 5) {
					const validIcon = document.getElementById("image-img-valid");

					if (validIcon) {
						validIcon.style.display = "none";
					}

					if (modalTitle) {
						modalTitle.textContent =
							"L'image dépasse la taille limite de 5Mo";
					}

					if (fileModal) {
						fileModal.style.display = "block";
						fileModal.classList.remove("hidden");
					}

					imageInput.value = "";

					return;
				}

				/*
				 * Aperçu de l'image
				 */
				const reader = new FileReader();

				reader.onload = function (e) {
					const preview = document.getElementById("image-preview");

					if (preview) {
						preview.src = e.target.result;
					}
				};

				reader.readAsDataURL(file);

				/*
				 * Nom du fichier
				 */
				const fileName = document.getElementById("image-file-name");

				if (fileName) {
					fileName.textContent = file.name;
				}

				/*
				 * Taille du fichier
				 */
				const fileSize = document.getElementById("image-file-size");

				if (fileSize) {
					fileSize.textContent = `Size: ${(file.size / 1024).toFixed(2)} KB`;
				}

				/*
				 * Icône validation
				 */
				const validIcon = document.getElementById("image-img-valid");

				if (validIcon) {
					validIcon.style.display = "block";
				}
			});
		}

		/*
		 * =========================================================
		 * MEDIA AUDIO / VIDEO
		 * =========================================================
		 */

		if (mediaInput) {
			mediaInput.addEventListener("change", function (event) {
				const file = event.target.files[0];

				if (!file) {
					return;
				}

				const fileSizeMB = file.size / (1024 * 1024);

				/*
				 * Limite : 50 MB
				 */
				if (fileSizeMB >= 50) {
					const validIcon = document.getElementById("media-img-valid");

					if (validIcon) {
						validIcon.style.display = "none";
					}

					if (modalTitle) {
						modalTitle.textContent =
							"Le média dépasse la taille limite de 50Mo";
					}

					if (fileModal) {
						fileModal.style.display = "block";
						fileModal.classList.remove("hidden");
					}

					mediaInput.value = "";

					return;
				}

				/*
				 * Nom du fichier
				 */
				const fileName = document.getElementById("media-file-name");

				if (fileName) {
					fileName.textContent = file.name;
				}

				/*
				 * Taille du fichier
				 */
				const fileSize = document.getElementById("media-file-size");

				if (fileSize) {
					fileSize.textContent = `Size: ${fileSizeMB.toFixed(2)} MB`;
				}

				/*
				 * Icône validation
				 */
				const validIcon = document.getElementById("media-img-valid");

				if (validIcon) {
					validIcon.style.display = "block";
				}
			});
		}
	})();
</script>



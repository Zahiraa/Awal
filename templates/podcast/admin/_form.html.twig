			SVG, PNG, JPG ou GIF (max. 800x400px)
			<br>

			La taille de l'image ne doit pas dépasser
			{{ maxTailleImage }}
		</p>

		{{ form_widget(form.image, {
            'attr': {
                'class': 'absolute opacity-0 w-0 h-0'
            }
        }) }}
	</label>


	<!-- Aperçu Image -->
	<div class="flex-1 flex items-center">

		<div
			class="rounded-2xl flex gap-4 justify-between p-2 w-full h-full"
			style="border: 1px solid #008780"
		>

			<img
				id="image-preview"
				src="{{ podcast.image ? '/uploads/' ~ podcast.image.name : asset('build/images/icons/upload.svg') }}"

			<div class="flex flex-col items-start justify-center flex-1">

				<p
					id="image-file-name"
					class="text-gray-600 font-bold text-xs break-all"
				>
					{{ podcast.image ? podcast.image.name : 'Aucun fichier sélectionné' }}
				</p>

				<p
					id="image-file-size"
					class="text-gray-600 font-bold text-xs mt-1"
				>
					Size:
					{{ podcast.image ? 'Précédent' : '0 KB' }}
				</p>

			</div>

			<img
				id="image-img-valid"
				style="{{ podcast.image ? 'display: block' : 'display: none' }}"
				src="{{ asset('build/images/icons/valid.svg') }}"
				class="w-5 h-5 rounded-2xl min-w-5 min-h-5 object-cover self-center"
				alt="Valid"
			>

		</div>
	</div>

</div>



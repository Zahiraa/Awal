			src="{{ asset('build/images/icons/upload.svg') }}"
			alt="Upload Image"
			width="40"
			height="40"
			class="rounded-full"
		>

		<p class="text-gray-600 text-center mt-2 font-bold text-sm md:text-base">
			<span class="text-pink-600">
				Cliquez pour télécharger l'Image du Podcast
			</span>

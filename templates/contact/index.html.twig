{% extends 'public.html.twig' %}

{% block title %}
	هيئة التحرير
{% endblock %}

{% block content %}
	<section class="py-24 bg-white min-h-[60vh] flex items-center justify-center" dir="rtl">
		<div class="max-w-3xl mx-auto px-6 text-center w-full">

			{# هيئة التحرير #}
			<h1 class="text-4xl md:text-5xl font-bold text-rose-600 mb-10" style="font-family: 'Amiri', serif;">
				هيئة التحرير
			</h1>

			<div class="bg-pink-50 rounded-3xl p-8 md:p-12 shadow-sm border border-[#FECDD3]">
				<div class="flex justify-center mb-6">
					<svg class="w-16 h-16 text-rose-400" fill="none" stroke="currentColor" viewbox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
					</svg>
				</div>

				<p class="text-xl md:text-2xl text-gray-700 font-medium leading-relaxed" style="font-family: 'Amiri', serif;">
					سيتم إضافة أعضاء هيئة التحرير قريبًا.
				</p>

				<p class="mt-4 text-gray-500 text-lg" style="font-family: 'Amiri', serif;">
					نشكركم على اهتمامكم ومتابعتكم المستمرة لمجلتنا.
				</p>
			</div>

			{# Invitation à contribuer #}
			<div class="mt-12 pt-10 border-t border-gray-200 text-center" style="font-family: 'Amiri', serif;">
				<h2 class="text-2xl md:text-3xl font-bold text-gray-800 mb-4">
					ساهمي في إثراء المجلة
				</h2>

				<p class="text-lg text-gray-600 leading-relaxed">
					للمساهمة في إثراء محتوى المجلة والانضمام إلى كتّابها، يمكنكن إرسال نصوصكنّ ومقالاتكنّ إلى البريد الإلكتروني التالي:
				</p>

				<a href="mailto:feminaawal@gmail.com" class="inline-block mt-3 text-lg text-rose-600 hover:text-blue-800 underline">
					feminaawal@gmail.com
				</a>

				<p class="mt-4 text-gray-500 text-lg">
					نسعد باستقبال إبداعاتكنّ وأفكاركنّ ومشاركاتكنّ.
				</p>
			</div>

		</div>
	</section>
{% endblock %}

<!-- Who Are We Section -->
<section id="who" class="py-24 bg-gray-50">
	<div class="max-w-5xl mx-auto px-6">
		<h2 class="text-5xl font-bold text-center mb-16">
			<span class="pink-underline">من نحن؟</span>
		</h2>

		<div class="bg-white rounded-3xl p-12 shadow-custom-lg space-y-8 text-center leading-relaxed text-xl text-gray-700">
			{% if about is defined and about is not empty %}
				{{ about.content|raw }}
			{% else %}
				<div class="text-center text-gray-500 py-12">
					لا يوجد محتوى حالياً.
				</div>
			{% endif %}
		</div>
	</div>
</section>

{% extends 'public.html.twig' %}

{% block title %}
	أرشيف حوار العدد - أوال فيمينا
{% endblock %}

{% block content %}
	<section class="py-24 bg-white" dir="rtl">
		<div class="max-w-7xl mx-auto px-6">
			<h2 class="text-5xl font-bold text-center mb-4">
				<span class="pink-underline">أرشيف حوار العدد</span>
			</h2>
			<p class="text-center text-gray-600 text-xl mb-16">
				استكشف حوارات الأعداد السابقة
			</p>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
				{% for discussion in discussionArchive %}
					<a href="{{ path('app_contenu_discussion_show', {'id': discussion.id}) }}">
						<div class="bg-white rounded-2xl border border-[#FFE4E6] shadow-custom-lg p-8 hover:shadow-xl transition relative">
							<div class="absolute top-4 left-4 bg-rose-500 text-white w-12 h-12 rounded-full flex items-center justify-center font-bold text-xl">
								{{ discussion.createdAt | date('m') }}
							</div>
							<div class="text-center">
								<h3 class="text-rose-600 text-2xl font-bold mb-4 px-4 py-2">{{ discussion.title }}</h3>
								<div class="flex justify-center items-center gap-4 text-gray-400 mb-6">
									<span>●</span>
									<span>{{ discussion.createdAt | date('Y') }}</span>
									<span>●</span>
								</div>
								<hr class="border-rose-200 mb-6"/>
							</div>
						</div>
					</a>
				{% else %}
					<div class="col-span-full text-center text-gray-500 py-12">
						لا يوجد نقاشات في الأرشيف حالياً.
					</div>
				{% endfor %}
			</div>
		</div>
	</section>
{% endblock %}

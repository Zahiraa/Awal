{% extends 'public.html.twig' %}

{% block title %}
	{{ contenu.title }}
{% endblock %}

{% block page_content %}

	{% set titleDir = 'ltr' %}
	{% if contenu.title is defined and contenu.title matches '/[\\x{0600}-\\x{06FF}]/u' %}
		{% set titleDir = 'rtl' %}
	{% endif %}

	{% set subTitleDir = 'ltr' %}
	{% if contenu.subTitle is defined and contenu.subTitle matches '/[\\x{0600}-\\x{06FF}]/u' %}
		{% set subTitleDir = 'rtl' %}
	{% endif %}

	<section class="py-24 bg-white">
		<div
			class="max-w-7xl mx-auto px-6">
			<!-- Main Title -->
			<div class="text-center mb-16">
				<h1 class="text-4xl md:text-5xl font-bold text-rose-600 mb-4" dir="{{ titleDir }}">
					{{ contenu.title }}
				</h1>

				{% if contenu.subTitle is defined %}
					<p class="text-xl text-gray-500" dir="{{ subTitleDir }}">
						{{ contenu.subTitle }}
					</p>
				{% endif %}
			</div>

			<!-- Grid of Cards -->
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
				{% for item in contenu_numeros %}

					{% set itemTitleDir = 'ltr' %}
					{% if item.title is defined and item.title matches '/[\\x{0600}-\\x{06FF}]/u' %}
						{% set itemTitleDir = 'rtl' %}
					{% endif %}

					{% set itemSubTitleDir = 'ltr' %}
					{% if item.subTitle is defined and item.subTitle matches '/[\\x{0600}-\\x{06FF}]/u' %}
						{% set itemSubTitleDir = 'rtl' %}
					{% endif %}

					<a href="{{ path('app_contenu_numero_show', {'id': item.id}) }}" class="h-full">
						<div
							class="bg-stone-50 rounded-3xl overflow-hidden shadow-sm hover:shadow-md transition-shadow duration-300 group h-full flex flex-col">

							<!-- Card Image -->
							<img
							src="{{ item.image ? asset('uploads/' ~ item.image.name) : asset('build/images/home/awal.jpeg') }}" alt="{{ item.image ? item.title : 'awal' }}" class="w-full h-64 object-cover transform group-hover:scale-105 transition-transform duration-500"/>

							<!-- Card Content -->
							<div class="p-8 flex-1 flex flex-col">
								<h3 class="text-2xl font-bold text-gray-900 mb-3 group-hover:text-rose-600 transition-colors" dir="{{ itemTitleDir }}">
									{{ item.title }}
								</h3>

								<p class="text-gray-600 leading-relaxed flex-1" dir="{{ itemSubTitleDir }}">
									{{ item.subTitle }}
								</p>
							</div>
						</div>
					</a>

				{% endfor %}
			</div>
		</div>
	</section>

{% endblock %}

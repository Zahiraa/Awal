{% extends 'public.html.twig' %}

{% block title %}
	{{ contenu.title }}
{% endblock %}

{% block page_content %}
	{% set audioTypes = [
    'mpeg',
    'wav',
    'ogg',
    'aac',
    'mp3'
] %}

	{% set videoTypes = [
    'mp4',
    'webm',
    'quicktime',
    'x-msvideo',
    'x-matroska'
] %}
	<section class="py-24 bg-white" dir="rtl">
		<div
			class="max-w-7xl mx-auto px-6">
			<!-- Main Title -->
			<div class="text-center mb-16">
				<h1 class="text-4xl md:text-5xl font-bold text-rose-600 mb-4">{{ contenu.title }}</h1>
				{% if contenu.subTitle is defined %}
					<p class="text-xl text-gray-500">{{ contenu.subTitle }}</p>
				{% endif %}
			</div>

			<style>
				.active-card {
					border-color: #E11D48 !important; /* rose-600 */
					background-color: #FFF1F2 !important; /* rose-50 */
					box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1) !important;
				}
			</style>

			<!-- Grid of Category Cards -->
			<div
				class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-16">

				<!-- Card 1: Contenu Discussion -->
				<button onclick="showSection('discussions', this)" class="category-card bg-stone-50 rounded-3xl p-8 border border-rose-100 hover:border-rose-300 shadow-sm hover:shadow-md transition duration-300 text-center flex flex-col items-center justify-center cursor-pointer group w-full">
					<div class="w-16 h-16 bg-rose-50 text-rose-500 rounded-full flex items-center justify-center mb-6 group-hover:bg-rose-500 group-hover:text-white transition duration-300">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewbox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z"/>
						</svg>
					</div>
					<h3 class="text-gray-900 text-2xl font-bold mb-2">حوار العدد</h3>
					<span class="text-rose-600 font-medium bg-rose-50 px-3 py-1 rounded-full text-sm">
						{{ contenu_discussions|length }}
						{% if contenu_discussions|length > 1 %}حوارات{% else %}حوار
						{% endif %}
					</span>
				</button>

				<!-- Card 2: Contenu Numeros -->
				<button onclick="showSection('numeros', this)" class="category-card bg-stone-50 rounded-3xl p-8 border border-rose-100 hover:border-rose-300 shadow-sm hover:shadow-md transition duration-300 text-center flex flex-col items-center justify-center cursor-pointer group active-card w-full">
					<div class="w-16 h-16 bg-rose-50 text-rose-500 rounded-full flex items-center justify-center mb-6 group-hover:bg-rose-500 group-hover:text-white transition duration-300">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewbox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
						</svg>
					</div>
					<h3 class="text-gray-900 text-2xl font-bold mb-2">ملف العدد</h3>
					<span class="text-rose-600 font-medium bg-rose-50 px-3 py-1 rounded-full text-sm">
						{{ contenu_numeros|length }}
						{% if contenu_numeros|length > 1 %}ملفات{% else %}ملف
						{% endif %}
					</span>
				</button>


				<!-- Card 3: Textes -->
				<button onclick="showSection('textes', this)" class="category-card bg-stone-50 rounded-3xl p-8 border border-rose-100 hover:border-rose-300 shadow-sm hover:shadow-md transition duration-300 text-center flex flex-col items-center justify-center cursor-pointer group w-full">
					<div class="w-16 h-16 bg-rose-50 text-rose-500 rounded-full flex items-center justify-center mb-6 group-hover:bg-rose-500 group-hover:text-white transition duration-300">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewbox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
						</svg>
					</div>
					<h3 class="text-gray-900 text-2xl font-bold mb-2">نصوص</h3>
					<span class="text-rose-600 font-medium bg-rose-50 px-3 py-1 rounded-full text-sm">
						{{ textes|length }}
						{% if textes|length > 1 %}نصوص{% else %}نص
						{% endif %}
					</span>
				</button>

				<!-- Card 4: Articles -->
				<button onclick="showSection('articles', this)" class="category-card bg-stone-50 rounded-3xl p-8 border border-rose-100 hover:border-rose-300 shadow-sm hover:shadow-md transition duration-300 text-center flex flex-col items-center justify-center cursor-pointer group w-full">
					<div class="w-16 h-16 bg-rose-50 text-rose-500 rounded-full flex items-center justify-center mb-6 group-hover:bg-rose-500 group-hover:text-white transition duration-300">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewbox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 4a2 2 0 00-2-2h-1V3a1 1 0 00-1-1H3a1 1 0 00-1 1v14a3 3 0 003 3h14a1 1 0 001-1v-4a1 1 0 00-1-1zM11 7H6m5 4H6m13 1v5a1 1 0 01-1 1h-2v-3h2m0-3v3h-2v-3h2z"/>
						</svg>
					</div>
					<h3 class="text-gray-900 text-2xl font-bold mb-2">اراء</h3>
					<span class="text-rose-600 font-medium bg-rose-50 px-3 py-1 rounded-full text-sm">
						{{ articles|length }}
						{% if articles|length > 1 %}اراء{% else %}رأي
						{% endif %}
					</span>
				</button>
			</div>

			<!-- Lists Containers -->
			<div>
				<!-- Section 1: Contenu Numeros -->
				<div id="section-numeros" class="section-container grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
					{% for item in contenu_numeros %}
						<a href="{{ path('app_contenu_numero_show', {'id': item.id}) }}" class="h-full">
							<div
								class="bg-stone-50 rounded-3xl overflow-hidden shadow-sm hover:shadow-md transition-shadow duration-300 group h-full flex flex-col">
								<!-- Card Image -->
								{% if item.image %}
									<div class="aspect-w-16 aspect-h-9 overflow-hidden">
										<img src="{{ asset('uploads/' ~ item.image.name) }}" alt="{{ item.title }}" class="w-full h-64 object-cover transform group-hover:scale-105 transition-transform duration-500"/>
									</div>
								{% endif %}

								<!-- Card Content -->
								<div class="p-8 flex-1 flex flex-col">
									<h3 class="text-2xl font-bold text-gray-900 mb-3 group-hover:text-rose-600 transition-colors">
										{{ item.title }}
									</h3>
									<p class="text-gray-600 leading-relaxed flex-1">
										{{ item.subTitle }}
									</p>
								</div>
							</div>
						</a>
					{% else %}
						<div class="col-span-full text-center text-gray-500 py-12">
							لا يوجد محتوى في هذا القسم حالياً.
						</div>
					{% endfor %}
				</div>

				<!-- Section 2: Discussions -->
				<div id="section-discussions" class="section-container hidden grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
					{% for item in contenu_discussions %}
						<a href="{{ path('app_contenu_discussion_show', {'id': item.id}) }}" class="h-full">
							<div
								class="bg-stone-50 rounded-3xl overflow-hidden shadow-sm hover:shadow-md transition-shadow duration-300 group h-full flex flex-col">
								<!-- Card Image -->
								{% if item.image %}
									<div class="aspect-w-16 aspect-h-9 overflow-hidden">
										<img src="{{ asset('uploads/' ~ item.image.name) }}" alt="{{ item.title }}" class="w-full h-64 object-cover transform group-hover:scale-105 transition-transform duration-500"/>
									</div>
								{% endif %}

								<!-- Card Content -->
								<div class="p-8 flex-1 flex flex-col">
									<h3 class="text-2xl font-bold text-gray-900 mb-3 group-hover:text-rose-600 transition-colors">
										{{ item.title }}
									</h3>
									<p class="text-gray-600 leading-relaxed flex-1">
										{{ item.subTitle }}
									</p>
								</div>
							</div>
						</a>
					{% else %}
						<div class="col-span-full text-center text-gray-500 py-12">
							لا يوجد محتوى في هذا القسم حالياً.
						</div>
					{% endfor %}
				</div>

				<!-- Section 3: Textes -->
				<div id="section-textes" class="section-container hidden grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
					{% for item in textes %}
						<a href="{{ path('app_texte_show_front', {'id': item.id}) }}" class="h-full">
							<div
								class="bg-stone-50 rounded-3xl overflow-hidden shadow-sm hover:shadow-md transition-shadow duration-300 group h-full flex flex-col">
								<!-- Card Image -->
								{% if item.image %}
									<div class="aspect-w-16 aspect-h-9 overflow-hidden">
										<img src="{{ asset('uploads/' ~ item.image.name) }}" alt="{{ item.title }}" class="w-full h-64 object-cover transform group-hover:scale-105 transition-transform duration-500"/>
									</div>
								{% endif %}

								<!-- Card Content -->
								<div class="p-8 flex-1 flex flex-col">
									<h3 class="text-2xl font-bold text-gray-900 mb-3 group-hover:text-rose-600 transition-colors">
										{{ item.title }}
									</h3>
									<p class="text-gray-600 leading-relaxed flex-1">
										{{ item.subTitle }}
									</p>
								</div>
							</div>
						</a>
					{% else %}
						<div class="col-span-full text-center text-gray-500 py-12">
							لا يوجد محتوى في هذا القسم حالياً.
						</div>
					{% endfor %}
				</div>

				<!-- Section 4: Articles -->
				<div id="section-articles" class="section-container hidden grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
					{% for item in articles %}
						<a href="{{ path('article_show', {'id': item.id}) }}" class="h-full">
							<div
								class="bg-stone-50 rounded-3xl overflow-hidden shadow-sm hover:shadow-md transition-shadow duration-300 group h-full flex flex-col">
								<!-- Card Image -->
								{% if item.author and item.author.image %}
									<div class="aspect-w-16 aspect-h-9 overflow-hidden">
										<img src="{{ asset('uploads/' ~ item.author.image.name) }}" alt="{{ item.author.name }}" class="w-full h-64 object-cover transform group-hover:scale-105 transition-transform duration-500"/>
									</div>
								{% endif %}

								<!-- Card Content -->
								<div class="p-8 flex-1 flex flex-col">
									<h3 class="text-2xl font-bold text-gray-900 mb-3 group-hover:text-rose-600 transition-colors">
										{{ item.titre }}
									</h3>
									<p class="text-gray-600 leading-relaxed flex-1">
										{% if item.media %}

											{% if item.media.extension in videoTypes %}
												شاهد الفيديو
											{% elseif item.media.extension in audioTypes %}
												استمع إلى التسجيل الصوتي
											{% else %}
												{{ item.content|striptags|slice(0, 150) }}...
											{% endif %}
										{% else %}
											{{ item.content|striptags|slice(0, 150) }}...
										{% endif %}
									</p>
								</div>
							</div>
						</a>
					{% else %}
						<div class="col-span-full text-center text-gray-500 py-12">
							لا يوجد محتوى في هذا القسم حالياً.
						</div>
					{% endfor %}
				</div>
			</div>

			<script>
				function showSection(sectionId, cardEl) { // Hide all section containers
document.querySelectorAll('.section-container').forEach(el => {
el.classList.add('hidden');
});

// Show targeted section container
const targetSection = document.getElementById('section-' + sectionId);
if (targetSection) {
targetSection.classList.remove('hidden');
}

// Reset active classes on all cards
document.querySelectorAll('.category-card').forEach(el => {
el.classList.remove('active-card');
});

// Add active class to clicked card
cardEl.classList.add('active-card');
}
			</script>
		</div>
	</section>
{% endblock %}
